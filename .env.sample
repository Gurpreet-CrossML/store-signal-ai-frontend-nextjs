NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET='your-django-secret-key'
# Encrypts and decrypts record id tokens (lib/public-ids). Must be the SAME value as the backend's URL_ID_KEY.
# Server only: never prefix it with NEXT_PUBLIC_.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
URL_ID_KEY='your-url-id-key'
NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WIDGET_SCRIPT_URL=http://localhost:3000/widget/chatbot-widget.js

# Database (PostgreSQL) configuration
DATABASE_URL="postgresql://your-neon-db-username:your-neon-db-password@your-neon-db-hostname/your-db-name?sslmode=require&channel_binding=require"

# AWS S3 configuration
AWS_STORAGE_BUCKET_NAME="your-s3-bucket-name"
AWS_REGION="your-aws-region"